generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}
model Admin {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  failedAttempts Int      @default(0)
  lockedUntil   DateTime?
  createdAt     DateTime  @default(now())
}
model User {
  id           String   @id @default(cuid())
  phone        String   @unique
  nationalId   String?
  firstName    String?
  lastName     String?
  fatherName   String?
  address      String?
  seedAmount   String?
  farmLocation String?
  contactPhone String?
  sheba        String?
  referralCode String?
  createdAt    DateTime @default(now())
  orders       Order[]
}

model Product {
  id          String   @id @default(cuid())
  name        String
  price       Int
  category    String
  description String?
  stock       Int      @default(0)
  createdAt   DateTime @default(now())
  orderItems  OrderItem[]
}

model Order {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  agentId   String?     
  status    String      @default("pending")
  total     Int
  createdAt DateTime    @default(now())
  items     OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Int
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}
model OrderStatusHistory {
  id        String   @id @default(cuid())
  orderId   String
  status    String
  changedAt DateTime @default(now())
}
// این مدل رو داخل schema.prisma اضافه کنید (کاملاً مجزا از مدل Admin موجود)
// بعدش:
//   npx prisma migrate dev --name add_content_admin
//   npx prisma generate

model ContentAdmin {
  id             String    @id @default(cuid())
  email          String    @unique
  password       String    // هش‌شده با bcrypt، دقیقاً مثل مدل Admin
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime  @default(now())
}

